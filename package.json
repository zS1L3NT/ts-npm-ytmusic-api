{
	"name": "ytmusic-api",
	"version": "7.0.0",
	"description": "YouTube Music API",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"author": "zS1L3NT <dev@zectan.com> (http://www.zectan.com)",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/zS1L3NT/ts-npm-ytmusic-api"
	},
	"files": ["dist", "package.json"],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsup src/index.ts",
		"typecheck": "tsc --noEmit -p tsconfig.tests.json",
		"lint": "bun run typecheck && biome check .",
		"lint:fix": "biome check --write .",
		"test": "bun test src/tests/unit",
		"test:coverage": "bun test src/tests/unit --coverage --coverage-reporter=text --coverage-reporter=lcov && node scripts/check-coverage.mjs",
		"test:live": "bun test src/tests/live --timeout 30000",
		"test:package": "node scripts/test-package.mjs"
	},
	"dependencies": {
		"axios": "^1.7.2",
		"tough-cookie": "^4.1.4",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@biomejs/biome": "1.8.3",
		"@types/tough-cookie": "^4.0.5",
		"bun-types": "^1.1.18",
		"tsup": "^8.1.0",
		"typescript": "5.1",
		"zod-to-json-schema": "^3.23.1"
	},
	"keywords": ["youtube", "music", "api"]
}
